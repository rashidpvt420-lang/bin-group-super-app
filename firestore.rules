    }

    match /keyMovements/{movementId} {
      allow read: if signedIn() && (isAdmin() || (docPropertyId(resource.data) != null && isPropertyOwner(docPropertyId(resource.data))) || (docUnitId(resource.data) != null && isUnitTenant(docUnitId(resource.data)) && getTenantPropertyId() == docPropertyId(resource.data)));
      allow create: if propertyScopedOwnerWrite(request.resource.data);
      allow update: if propertyScopedOwnerWrite(resource.data);
      allow delete: if propertyScopedOwnerWrite(resource.data);
    }

    match /parcels/{parcelId} {
      allow read: if isAdmin() || (docPropertyId(resource.data) != null && isPropertyOwner(docPropertyId(resource.data))) || tenantUidOwns(resource.data);
      allow create: if propertyScopedOwnerWrite(request.resource.data);
      allow update: if isAdmin() || (docPropertyId(resource.data) != null && isPropertyOwner(docPropertyId(resource.data))) || (tenantUidOwns(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'collectedBy', 'collectedAt', 'notes']));
      allow delete: if isAdmin();
    }

    match /visitorParkingRequests/{requestId} {
      allow read: if isAdmin() || (docPropertyId(resource.data) != null && isPropertyOwner(docPropertyId(resource.data))) || tenantUidOwns(resource.data);
      allow create: if signedIn() && request.resource.data.get('tenantUid', null) == request.auth.uid && getTenantPropertyId() == docPropertyId(request.resource.data) && docUnitId(request.resource.data) != null && isUnitTenant(docUnitId(request.resource.data));
      allow update: if isAdmin() || (docPropertyId(resource.data) != null && isPropertyOwner(docPropertyId(resource.data))) || (tenantUidOwns(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'visitStartAt', 'visitEndAt', 'visitorName', 'vehiclePlate']));
      allow delete: if propertyScopedOwnerWrite(resource.data);
    }

    match /marketplaceProviders/{providerId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /marketplaceOffers/{offerId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /staffDirectory/{staffId} {
      allow read: if propertyScopedRead(resource.data);
      allow create: if propertyScopedOwnerWrite(request.resource.data);
      allow update: if propertyScopedOwnerWrite(resource.data);
      allow delete: if propertyScopedOwnerWrite(resource.data);
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.get('participantUids', []));
      allow create: if signedIn() && request.auth.uid in request.resource.data.get('participantUids', []);
      allow update: if isAdmin() || (signedIn() && request.auth.uid in resource.data.get('participantUids', []) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'status']));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if exists(/databases/$(database)/documents/conversations/$(conversationId)) && (isAdmin() || request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('participantUids', []));
        allow create: if exists(/databases/$(database)/documents/conversations/$(conversationId)) && (isAdmin() || request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('participantUids', [])) && request.resource.data.get('senderUid', null) == request.auth.uid;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /communityPosts/{postId} {
      allow read: if signedIn() && (isAdmin() || (docPropertyId(resource.data) != null && isPropertyOwner(docPropertyId(resource.data))) || (getTenantPropertyId() == docPropertyId(resource.data) && (resource.data.get('status', null) == 'approved' || resource.data.get('authorUid', null) == request.auth.uid)));
      allow create: if signedIn() && request.resource.data.get('authorUid', null) == request.auth.uid && getTenantPropertyId() == docPropertyId(request.resource.data) && request.resource.data.get('status', null) == 'pending';
      allow update: if isAdmin() || (docPropertyId(resource.data) != null && isPropertyOwner(docPropertyId(resource.data))) || (signedIn() && resource.data.get('authorUid', null) == request.auth.uid && request.resource.data.get('authorUid', null) == request.auth.uid && request.resource.data.get('status', null) == resource.data.get('status', null) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'updatedAt']));
      allow delete: if isAdmin() || (docPropertyId(resource.data) != null && isPropertyOwner(docPropertyId(resource.data))) || (signedIn() && resource.data.get('authorUid', null) == request.auth.uid);
    }

    match /communityComments/{commentId} {
      allow read: if propertyScopedRead(resource.data);
      allow create: if signedIn() && request.resource.data.get('authorUid', null) == request.auth.uid && getTenantPropertyId() == docPropertyId(request.resource.data);
      allow update: if isAdmin() || (signedIn() && resource.data.get('authorUid', null) == request.auth.uid && request.resource.data.get('authorUid', null) == request.auth.uid);
      allow delete: if isAdmin() || (docPropertyId(resource.data) != null && isPropertyOwner(docPropertyId(resource.data))) || (signedIn() && resource.data.get('authorUid', null) == request.auth.uid);
    }

    match /pricingAuditLogs/{logId} {
      allow read: if isAdmin() || (signedIn() && resource.data.get('ownerId', null) == request.auth.uid);
      allow create: if signedIn() && request.resource.data.get('ownerId', null) == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /turnover-quotes/{quoteId} {
      allow read: if isAdmin() || (signedIn() && resource.data.get('ownerId', null) == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || (signedIn() && resource.data.get('ownerId', null) == request.auth.uid && request.resource.data.get('status', null) in ['APPROVED', 'REJECTED'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /ownerBankAccounts/{accountId} {
      allow read: if isAdmin() || ownerBankOwner(resource.data);
      allow create: if isAdmin() || safeOwnerBankAccountCreate(request.resource.data);
      allow update: if isAdmin() || safeOwnerBankAccountUpdate();
      allow delete: if isAdmin();
    }

    match /propertyPassports/{passportId} {
      allow read: if isAdmin() || (signedIn() && (resource.data.get('ownerId', null) == request.auth.uid || emailMatches(resource.data.get('ownerEmail', null))));
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /brokerDocuments/{documentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.get('brokerId', null) == request.auth.uid);
      allow create: if signedIn() && request.resource.data.get('brokerId', null) == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.get('brokerId', null) == request.auth.uid);
    }

    match /move_out_requests/{requestId} {
      allow read: if isAdmin() || (signedIn() && (resource.data.get('userId', null) == request.auth.uid || resource.data.get('tenantUid', null) == request.auth.uid));
      allow create: if signedIn() && (request.resource.data.get('userId', null) == request.auth.uid || request.resource.data.get('tenantUid', null) == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /tenant_ledger/{ledgerId} {
      allow read: if isAdmin() || (signedIn() && resource.data.get('tenantId', null) == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /design_requests/{requestId} {
      allow read: if isAdmin() || (signedIn() && (resource.data.get('userId', null) == request.auth.uid || resource.data.get('ownerId', null) == request.auth.uid || resource.data.get('tenantId', null) == request.auth.uid));
      allow create: if signedIn() && (request.resource.data.get('userId', null) == request.auth.uid || request.resource.data.get('createdByUid', null) == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && (
        (resource.data.get('ownerId', null) == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvalStatus', 'quoteStatus', 'workflowStage', 'payerRole', 'payerEmail', 'updatedAt'])) ||
        ((resource.data.get('userId', null) == request.auth.uid || resource.data.get('payerId', null) == request.auth.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'workflowStage', 'payerRole', 'payerEmail', 'updatedAt']))
      ));
      allow delete: if isAdmin();
    }

    match /design_quotes/{quoteId} {
      allow read: if isAdmin() || (signedIn() && (resource.data.get('userId', null) == request.auth.uid || resource.data.get('ownerId', null) == request.auth.uid || resource.data.get('tenantId', null) == request.auth.uid));
      allow create: if signedIn() && (request.resource.data.get('userId', null) == request.auth.uid || request.resource.data.get('createdByUid', null) == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /design_concepts/{conceptId} {
      allow read: if isAdmin() || (signedIn() && (resource.data.get('userId', null) == request.auth.uid || resource.data.get('ownerId', null) == request.auth.uid || resource.data.get('tenantId', null) == request.auth.uid));
      allow create: if signedIn() && (request.resource.data.get('userId', null) == request.auth.uid || request.resource.data.get('tenantId', null) == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /design_approvals/{approvalId} {
      allow read: if isAdmin() || (signedIn() && (resource.data.get('tenantUid', null) == request.auth.uid || resource.data.get('ownerId', null) == request.auth.uid));
      allow create: if signedIn() && (request.resource.data.get('tenantUid', null) == request.auth.uid || request.resource.data.get('ownerId', null) == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && (resource.data.get('ownerId', null) == request.auth.uid || resource.data.get('tenantUid', null) == request.auth.uid));
      allow delete: if isAdmin();
    }

    match /pilotFeedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.get('status', null) == 'new';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // RFQ -> vendor quote -> owner approval procurement trust workflow
    // (RfqTrustWorkflowPage, VendorCommandCenterPage, OwnerApprovalCenterPage).
    match /vendor_rfqs/{rfqId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /vendor_quotes/{quoteId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /vendors/{vendorId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /owner_approval_requests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.get('ownerId', null) == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.get('ownerId', null) == request.auth.uid &&
        request.resource.data.get('ownerId', null) == resource.data.get('ownerId', null) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decision', 'decisionNote', 'ownerDecisionBy', 'decidedAt', 'updatedAt']) &&
        request.resource.data.get('ownerDecisionBy', null) == request.auth.uid &&
        request.resource.data.get('decision', null) in ['APPROVED', 'REJECTED', 'REQUEST_MORE_QUOTES', 'EMERGENCY_APPROVED'] &&
        request.resource.data.get('status', null) in ['owner_approved', 'owner_approved_emergency', 'owner_rejected', 'more_quotes_requested']
      );
      allow delete: if isAdmin();
    }

    match /maintenance_ledger/{ledgerId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /data_governance_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /communication_intake/{intakeId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }


    function isBinConnectParticipant(data) {
      return signedIn() && (
        isAdmin() ||
        (data.get('participantIds', []) is list && request.auth.uid in data.get('participantIds', [])) ||
        data.get('createdBy', null) == request.auth.uid ||
        data.get('assignedAdminId', null) == request.auth.uid
      );
    }

    function safeBinConnectThreadCreate(data) {
      return signedIn() &&
        data.get('createdBy', null) == request.auth.uid &&
        data.get('participantIds', []) is list &&
        request.auth.uid in data.get('participantIds', []) &&
        data.get('status', null) in ['open', 'pending', 'new'] &&
        data.get('channel', null) in ['company_ceo', 'admin_support', 'owner_to_tenant', 'owner_to_technician', 'majlis_staff', 'maintenance_chat', 'feature_suggestion', 'dashboard_issue'];
    }

    match /binConnectThreads/{threadId} {
      allow read: if isAdmin() || isBinConnectParticipant(resource.data);
      allow create: if safeBinConnectThreadCreate(request.resource.data);
      allow update: if isAdmin() || (isBinConnectParticipant(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'updatedAt', 'status']));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if exists(/databases/$(database)/documents/binConnectThreads/$(threadId)) && (isAdmin() || isBinConnectParticipant(get(/databases/$(database)/documents/binConnectThreads/$(threadId)).data));
        allow create: if exists(/databases/$(database)/documents/binConnectThreads/$(threadId)) &&
          (isAdmin() || isBinConnectParticipant(get(/databases/$(database)/documents/binConnectThreads/$(threadId)).data)) &&
          request.resource.data.get('senderId', null) == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ── inspections: move-in / move-out digital inspection records ──────────
    match /inspections/{inspectionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.get('tenantId', null) == request.auth.uid);
      allow create: if signedIn() && request.resource.data.get('tenantId', null) == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── maintenanceRequests: AI concierge ticket submissions ─────────────────
    match /maintenanceRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.get('tenantId', null) == request.auth.uid);
      allow create: if signedIn() && request.resource.data.get('tenantId', null) == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.get('tenantId', null) == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // ── Broker Pipeline Collections ──────────────────────────────────────────
    match /brokerLeads/{leadId} {
      allow read: if isAdmin() || (signedIn() && resource.data.get('brokerId', null) == request.auth.uid);
      allow create: if signedIn() && request.resource.data.get('brokerId', null) == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.get('brokerId', null) == request.auth.uid && request.resource.data.get('brokerId', null) == request.auth.uid);
      allow delete: if isAdmin();
    }
    match /referrals/{referralId} {
      allow read: if isAdmin() || (signedIn() && resource.data.get('brokerId', null) == request.auth.uid);
      allow create: if signedIn() && request.resource.data.get('brokerId', null) == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.get('brokerId', null) == request.auth.uid && request.resource.data.get('brokerId', null) == request.auth.uid);
      allow delete: if isAdmin();
    }
    match /broker_commissions/{commissionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.get('brokerId', null) == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /contract_renewal_watch/{watchId} {
      allow read: if participantCanRead(resource.data) || emailOwns(resource.data);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /document_generation_requests/{requestId} {
      allow read: if participantCanRead(resource.data) || emailOwns(resource.data);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /broker_listing_claims/{claimId} {
      allow read: if isAdmin() || (signedIn() && resource.data.get('brokerId', null) == request.auth.uid);
      allow create: if signedIn() && request.resource.data.get('brokerId', null) == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Previously unruled collections — were silently falling through to the
    // admin-only catch-all below. Scoped per their actual client usage. ──────
    match /active_contracts/{contractId} {
      allow read: if isAdmin();
      allow write: if false; // No client writer exists today.
    }

    match /onboarding_leads/{leadId} {
      allow read: if isAdmin();
      allow write: if false; // No client writer exists today.
    }

    match /analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create: if true; // Fires from public marketing pages before login.
      allow update, delete: if false;
    }

    match /security_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true; // Anonymous quote/OTP/blocked-attempt logging before login.
      allow update, delete: if false;
    }

    match /telemetry_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true; // Client crash reporter can fire before login.
      allow update, delete: if false;
    }

    match /jobPostings/{jobId} {
      allow read: if isAdmin() || emailOwns(resource.data);
      allow create: if signedIn() && emailOwns(request.resource.data);
      allow update: if isAdmin() || emailOwns(resource.data);
      allow delete: if isAdmin();
    }

    match /contractorBids/{bidId} {
      allow read: if isAdmin() || (signedIn() &&
        exists(/databases/$(database)/documents/jobPostings/$(resource.data.get('jobId', ''))) &&
        emailOwns(get(/databases/$(database)/documents/jobPostings/$(resource.data.get('jobId', ''))).data));
      allow create: if isAdmin();
      allow update: if isAdmin() || (signedIn() &&
        exists(/databases/$(database)/documents/jobPostings/$(resource.data.get('jobId', ''))) &&
        emailOwns(get(/databases/$(database)/documents/jobPostings/$(resource.data.get('jobId', ''))).data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['awarded']));
      allow delete: if isAdmin();
    }

    match /contractorProfiles/{profileId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /payouts/{payoutId} {
      allow read: if isAdmin() || emailOwns(resource.data);
      allow write: if isAdmin();
    }

    match /payroll_entries/{entryId} {
      allow read: if isAdmin() || isTechnicianId(resource.data.get('technicianId', null));
      allow write: if isAdmin();
    }

    match /support_chats/{messageId} {
      allow read: if isAdmin() || isOwnerId(resource.data.get('chatId', null));
      allow create: if isAdmin() || (signedIn() &&
        request.resource.data.get('chatId', null) == request.auth.uid &&
        request.resource.data.get('senderId', null) == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /systemMetrics/{metricId} {
      allow read: if isAdmin();
      allow write: if false; // Written server-side via Admin SDK.
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin() || isOwnerId(resource.data.get('ownerId', null)) || isTechnicianId(resource.data.get('techId', null));
      allow create: if isAdmin() || (signedIn() && isOwnerId(request.resource.data.get('ownerId', null)));
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read: if hasAdminClaim();
      allow create: if hasAdminClaim();
      allow update: if hasAdminClaim();
      allow delete: if hasAdminClaim();
    }
  }
}
