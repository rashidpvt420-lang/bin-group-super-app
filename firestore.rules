rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function adminProfileGrantsAccess() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('ceo', false) == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'super_admin', 'ceo', 'manager', 'operations_admin', 'finance_admin', 'hr_admin', 'support_admin'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userRole', '') in ['admin', 'super_admin', 'ceo', 'manager', 'operations_admin', 'finance_admin', 'hr_admin', 'support_admin'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('primaryRole', '') in ['admin', 'super_admin', 'ceo', 'manager', 'operations_admin', 'finance_admin', 'hr_admin', 'support_admin']
      );
    }

    function hasAdminClaim() {
      return signedIn() && (
        ('admin' in request.auth.token && request.auth.token.get('admin', false) == true) ||
        ('isAdmin' in request.auth.token && request.auth.token.get('isAdmin', false) == true) ||
        ('superAdmin' in request.auth.token && request.auth.token.get('superAdmin', false) == true) ||
        ('super_admin' in request.auth.token && request.auth.token.get('super_admin', false) == true) ||
        ('ceo' in request.auth.token && request.auth.token.get('ceo', false) == true) ||
        ('manager' in request.auth.token && request.auth.token.get('manager', false) == true) ||
        ('role' in request.auth.token && request.auth.token.get('role', '') in ['admin', 'super_admin', 'ceo', 'manager', 'operations_admin', 'finance_admin', 'hr_admin', 'support_admin']) ||
        ('userRole' in request.auth.token && request.auth.token.get('userRole', '') in ['admin', 'super_admin', 'ceo', 'manager', 'operations_admin', 'finance_admin', 'hr_admin', 'support_admin']) ||
        ('primaryRole' in request.auth.token && request.auth.token.get('primaryRole', '') in ['admin', 'super_admin', 'ceo', 'manager', 'operations_admin', 'finance_admin', 'hr_admin', 'support_admin'])
      );
    }

    function isAdmin() {
      return hasAdminClaim() || adminProfileGrantsAccess();
    }

    function isHr() {
      return isAdmin() || (signedIn() && (
        ('role' in request.auth.token && request.auth.token.role in ['hr_admin', 'hr_manager', 'hr_staff']) ||
        ('userRole' in request.auth.token && request.auth.token.userRole in ['hr_admin', 'hr_manager', 'hr_staff']) ||
        ('primaryRole' in request.auth.token && request.auth.token.primaryRole in ['hr_admin', 'hr_manager', 'hr_staff'])
      ));
    }

    function isHrManagerTier() {
      return isAdmin() || (signedIn() && (
        ('role' in request.auth.token && request.auth.token.role in ['hr_admin', 'hr_manager']) ||
        ('userRole' in request.auth.token && request.auth.token.userRole in ['hr_admin', 'hr_manager']) ||
        ('primaryRole' in request.auth.token && request.auth.token.primaryRole in ['hr_admin', 'hr_manager'])
      ));
    }

    function isFinance() {
      return isAdmin() || (signedIn() && (
        ('role' in request.auth.token && request.auth.token.role in ['finance_admin', 'finance_staff', 'account_manager']) ||
        ('userRole' in request.auth.token && request.auth.token.userRole in ['finance_admin', 'finance_staff', 'account_manager']) ||
        ('primaryRole' in request.auth.token && request.auth.token.primaryRole in ['finance_admin', 'finance_staff', 'account_manager'])
      ));
    }

    function isOps() {
      return isAdmin() || (signedIn() && (
        ('role' in request.auth.token && request.auth.token.role in ['operations_admin', 'operations_manager', 'dispatcher']) ||
        ('userRole' in request.auth.token && request.auth.token.userRole in ['operations_admin', 'operations_manager', 'dispatcher']) ||
        ('primaryRole' in request.auth.token && request.auth.token.primaryRole in ['operations_admin', 'operations_manager', 'dispatcher'])
      ));
    }

    function isAuditor() {
      return isAdmin() || (signedIn() && (
        ('role' in request.auth.token && request.auth.token.role in ['auditor', 'AUDITOR']) ||
        ('userRole' in request.auth.token && request.auth.token.userRole in ['auditor', 'AUDITOR']) ||
        ('primaryRole' in request.auth.token && request.auth.token.primaryRole in ['auditor', 'AUDITOR']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['auditor', 'AUDITOR'])
      ));
    }

    function hasPermission(permission) {
      return signedIn() && 'permissions' in request.auth.token && request.auth.token.permissions.get(permission, false) == true;
    }

    function canManageProperties() { return isAdmin() || hasPermission('canManageProperties'); }
    function canManageContracts() { return isAdmin() || hasPermission('canManageContracts'); }
    function canManageCompanyProfile() { return isAdmin() || hasPermission('canManageCompanyProfile'); }
    function canDispatchJobs() {
      return hasAdminClaim() ||
        hasPermission('canDispatchJobs') ||
        (signedIn() && (
          request.auth.token.get('role', '') in ['operations_manager', 'dispatcher'] ||
          request.auth.token.get('userRole', '') in ['operations_manager', 'dispatcher'] ||
          request.auth.token.get('primaryRole', '') in ['operations_manager', 'dispatcher']
        ));
    }

    function authEmail() { return signedIn() ? request.auth.token.get('email', null) : null; }
    function emailMatches(value) { return signedIn() && authEmail() != null && value != null && value == authEmail(); }
    function isOwnerId(ownerId) { return signedIn() && ownerId != null && ownerId == request.auth.uid; }
    function isOwner(ownerId) { return isOwnerId(ownerId); }
    function isTenantId(tenantId) { return signedIn() && tenantId != null && tenantId == request.auth.uid; }
    function isTechnicianId(techId) { return signedIn() && techId != null && techId == request.auth.uid; }

    function getTenantPropertyId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('propertyId', null) : null;
    }
    function isUnitTenant(unitId) {
      return signedIn() &&
        unitId is string &&
        exists(/databases/$(database)/documents/units/$(unitId)) && (
          get(/databases/$(database)/documents/units/$(unitId)).data.get('tenantId', null) == request.auth.uid ||
          get(/databases/$(database)/documents/units/$(unitId)).data.get('tenantUid', null) == request.auth.uid ||
          get(/databases/$(database)/documents/units/$(unitId)).data.get('userId', null) == request.auth.uid ||
          get(/databases/$(database)/documents/units/$(unitId)).data.get('authUid', null) == request.auth.uid ||
          emailMatches(get(/databases/$(database)/documents/units/$(unitId)).data.get('tenantEmail', null))
        );
    }
    function isPropertyOwner(propertyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/properties/$(propertyId)) && (
          get(/databases/$(database)/documents/properties/$(propertyId)).data.get('ownerId', null) == request.auth.uid ||
          get(/databases/$(database)/documents/properties/$(propertyId)).data.get('ownerUid', null) == request.auth.uid
        );
    }

    function owns(data) {
      return isOwnerId(data.get('ownerId', null)) || isOwnerId(data.get('ownerUid', null)) || isOwnerId(data.get('authUid', null)) || isOwnerId(data.get('userId', null)) || isOwnerId(data.get('createdBy', null)) || isOwnerId(data.get('createdByUid', null));
    }

    function tenantOwns(data) {
      return isTenantId(data.get('tenantId', null)) || isTenantId(data.get('tenantUid', null)) || isTenantId(data.get('authUid', null)) || isTenantId(data.get('userId', null)) || isTenantId(data.get('createdByUid', null));
    }

    function techOwns(data) {
      return isTechnicianId(data.get('assignedTechnicianId', null)) || isTechnicianId(data.get('technicianId', null)) || isTechnicianId(data.get('techId', null));
    }

    function brokerOwns(data) {
      return signedIn() && (
        data.get('brokerId', null) == request.auth.uid ||
        data.get('brokerUid', null) == request.auth.uid ||
        data.get('userId', null) == request.auth.uid ||
        data.get('createdByUid', null) == request.auth.uid
      );
    }

    function brokerOwns(data) {
      return signedIn() && (
        data.brokerId == request.auth.uid ||
        data.brokerUid == request.auth.uid ||
        data.userId == request.auth.uid ||
        data.createdByUid == request.auth.uid
      );
    }

    function emailOwns(data) {
      return emailMatches(data.get('email', null)) ||
        emailMatches(data.get('ownerEmail', null)) ||
        emailMatches(data.get('tenantEmail', null)) ||
        emailMatches(data.get('technicianEmail', null)) ||
        emailMatches(data.get('staffEmail', null)) ||
        emailMatches(data.get('brokerEmail', null)) ||
        emailMatches(data.get('recipientEmail', null)) ||
        emailMatches(data.get('contactEmail', null));
    }

    function ownerCanRead(data) { return signedIn() && (owns(data) || emailOwns(data)); }
    function staffCanRead(data) { return signedIn() && (techOwns(data) || isTechnicianId(data.get('uid', null)) || isTechnicianId(data.get('userId', null)) || isTechnicianId(data.get('technicianId', null)) || isTechnicianId(data.get('staffId', null)) || emailOwns(data)); }
    function staffCanCreate(data) { return signedIn() && (isTechnicianId(data.get('uid', null)) || isTechnicianId(data.get('userId', null)) || isTechnicianId(data.get('technicianId', null)) || isTechnicianId(data.get('staffId', null)) || emailOwns(data)); }
    function docPropertyId(data) { return data.get('propertyId', null); }
    function docUnitId(data) { return data.get('unitId', null); }
    function tenantUidOwns(data) { return isTenantId(data.get('tenantUid', null)); }
    function propertyScopedRead(data) {
      return signedIn() && (
        isAdmin() ||
        (docPropertyId(data) != null && isPropertyOwner(docPropertyId(data))) ||
        (docPropertyId(data) != null && getTenantPropertyId() == docPropertyId(data))
      );
    }
    function propertyScopedOwnerWrite(data) {
      return isAdmin() || (docPropertyId(data) != null && isPropertyOwner(docPropertyId(data)));
    }
    function isConfidentialRequest(data) {
      return ('requestType' in data && data.requestType == 'manager_issue') || ('category' in data && data.category == 'confidential');
    }

    function isTechnicianActor() {
      return signedIn() && (
        ('role' in request.auth.token && request.auth.token.role == 'technician') ||
        ('userRole' in request.auth.token && request.auth.token.userRole == 'technician') ||
        ('primaryRole' in request.auth.token && request.auth.token.primaryRole == 'technician') ||
        exists(/databases/$(database)/documents/technicians/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'technician')
      );
    }

    function hasTechnicianDispatchAuthority() {
      return signedIn() && (
        ('role' in request.auth.token && request.auth.token.role in ['admin', 'super_admin', 'operations_admin', 'operations_manager', 'dispatcher', 'technician']) ||
        ('userRole' in request.auth.token && request.auth.token.userRole in ['admin', 'super_admin', 'operations_admin', 'operations_manager', 'dispatcher', 'technician']) ||
        ('primaryRole' in request.auth.token && request.auth.token.primaryRole in ['admin', 'super_admin', 'operations_admin', 'operations_manager', 'dispatcher', 'technician']) ||
        isTechnicianActor()
      );
    }

    function openMissionAvailable(data) {
      return data.get('assignedTechnicianId', null) == null &&
        data.get('technicianId', null) == null &&
        data.get('techId', null) == null &&
        data.get('status', null) in ['OPEN', 'open', 'emergency_submitted'];
    }
    function openMissionPoolRead(data) { return hasTechnicianDispatchAuthority() && openMissionAvailable(data); }
    function participantCanRead(data) { return isAdmin() || ownerCanRead(data) || tenantOwns(data) || techOwns(data) || brokerOwns(data); }

    function staffRequestCreate(data) {
      return staffCanCreate(data) &&
        (!('status' in data) || data.status in ['pending_hr_review', 'pending_finance_review', 'submitted']) &&
        (!('paperless' in data) || data.paperless == true) &&
        (!('payrollApproved' in data) || data.payrollApproved == false) &&
        (!('hrApproved' in data) || data.hrApproved == false) &&
        (!('approved' in data) || data.approved == false);
    }

    function ownerDraftCreate(data) {
      return signedIn() && owns(data) &&
        (!('status' in data) || data.status in ['draft', 'quote_generated', 'contract_selected', 'payment_pending', 'pending_admin_approval', 'pending_approval']) &&
        (!('paymentVerified' in data) || data.paymentVerified == false) &&
        (!('adminApproved' in data) || data.adminApproved == false) &&
        (!('approved' in data) || data.approved == false) &&
        (!('contractActivated' in data) || data.contractActivated == false) &&
        (!('unlocksDashboard' in data) || data.unlocksDashboard == false);
    }

    function paymentDraftCreate(data) {
      return signedIn() && (owns(data) || tenantOwns(data) || data.get('payerId', null) == request.auth.uid || data.get('userId', null) == request.auth.uid) &&
        (!('status' in data) || data.status in ['draft', 'payment_pending', 'pending', 'PENDING_PAYMENT', 'PENDING_ADMIN_PAYMENT_VERIFICATION', 'ADMIN_VERIFICATION_REQUIRED']) &&
        (!('paymentVerified' in data) || data.paymentVerified == false) &&
        (!('approved' in data) || data.approved == false) &&
        (!('contractActivated' in data) || data.contractActivated == false) &&
        (!('unlocksDashboard' in data) || data.unlocksDashboard == false);
    }

    function paymentConfirmationCreate(data) {
      return signedIn() && tenantOwns(data) &&
        (!('status' in data) || data.status in ['pending_verification', 'pending']) &&
        (!('paymentVerified' in data) || data.paymentVerified == false) &&
        (!('approved' in data) || data.approved == false);
    }

    function safeClientNotificationCreate(data) {
      return signedIn() &&
        (('recipientId' in data && data.recipientId == request.auth.uid) || ('userId' in data && data.userId == request.auth.uid)) &&
        (!('recipientId' in data) || data.recipientId == request.auth.uid) &&
        (!('userId' in data) || data.userId == request.auth.uid) &&
        (!('createdBy' in data) || data.createdBy == request.auth.uid) &&
        data.type in ['USER_NOTE', 'PROFILE_REMINDER', 'PREFERENCE_UPDATE', 'SUPPORT_RECEIPT'] &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
        data.body is string && data.body.size() > 0 && data.body.size() <= 1000 &&
        (!('read' in data) || data.read == false) &&
        (!('priority' in data) || data.priority in ['LOW', 'NORMAL']) &&
        request.resource.data.keys().hasOnly(['recipientId', 'userId', 'createdBy', 'type', 'title', 'body', 'read', 'priority', 'link', 'createdAt']);
    }



    function safeTenantUnitLinkRequestCreate(data) {
      return signedIn() &&
        tenantOwns(data) &&
        data.status == 'PENDING_ADMIN_REVIEW' &&
        data.verificationState == 'ADMIN_OR_OWNER_VERIFICATION_REQUIRED' &&
        data.unitNumber is string &&
        data.unitNumber.size() > 0 &&
        (!('approvedAt' in data) || data.approvedAt == null) &&
        (!('approvedBy' in data) || data.approvedBy == null) &&
        (!('linkedUnitId' in data) || data.linkedUnitId == null) &&
        (!('linkedAt' in data) || data.linkedAt == null);
    }

    function safeOwnerContractUpdate() {
      return signedIn() && owns(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'signedAt', 'updatedAt']) &&
        (!('paymentVerified' in request.resource.data) || request.resource.data.paymentVerified == resource.data.get('paymentVerified', null)) &&
        (!('status' in request.resource.data) || !(request.resource.data.status in ['active', 'ACTIVE']));
    }

    function safeTenantEvidenceUpdate() {
      return signedIn() && tenantOwns(resource.data) &&
        (!('evidenceStatus' in request.resource.data) || request.resource.data.evidenceStatus in ['PENDING_TENANT_UPLOAD', 'TENANT_EVIDENCE_UPLOADED', 'TENANT_EVIDENCE_UPLOAD_FAILED']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photos', 'primaryPhotoUrl', 'tenantPhotos', 'evidenceStatus', 'evidenceUploadedAt', 'evidenceUploadError', 'updatedAt']);
    }



    function canCreateTenantBoundTicket(data) {
      return signedIn() &&
        tenantOwns(data) &&
        data.keys().hasAll(['unitId', 'propertyId']) &&
        data.get('unitId', null) is string &&
        data.get('propertyId', null) is string &&
        data.get('unitId', '').size() > 0 &&
        isUnitTenant(data.get('unitId', null)) &&
        data.get('propertyId', null) == get(/databases/$(database)/documents/units/$(data.get('unitId', null))).data.get('propertyId', null) &&
        (!('ownerId' in data) || data.get('ownerId', null) == get(/databases/$(database)/documents/units/$(data.get('unitId', null))).data.get('ownerId', null)) &&
        (!('ownerUid' in data) || data.get('ownerUid', null) == get(/databases/$(database)/documents/units/$(data.get('unitId', null))).data.get('ownerUid', null));
    }


    function canCreateTenantBoundTicket(data) {
      return signedIn() &&
        tenantOwns(data) &&
        data.keys().hasAll(['unitId', 'propertyId']) &&
        data.unitId is string &&
        data.propertyId is string &&
        data.unitId.size() > 0 &&
        exists(/databases/$(database)/documents/units/$(data.unitId)) &&
        (
          isTenantId(get(/databases/$(database)/documents/units/$(data.unitId)).data.tenantId) ||
          isTenantId(get(/databases/$(database)/documents/units/$(data.unitId)).data.tenantUid) ||
          isTenantId(get(/databases/$(database)/documents/units/$(data.unitId)).data.userId) ||
          isTenantId(get(/databases/$(database)/documents/units/$(data.unitId)).data.authUid) ||
          emailMatches(get(/databases/$(database)/documents/units/$(data.unitId)).data.tenantEmail)
        ) &&
        data.propertyId == get(/databases/$(database)/documents/units/$(data.unitId)).data.propertyId &&
        (!('ownerId' in data) || !('ownerId' in get(/databases/$(database)/documents/units/$(data.unitId)).data) || data.ownerId == get(/databases/$(database)/documents/units/$(data.unitId)).data.ownerId) &&
        (!('ownerUid' in data) || !('ownerUid' in get(/databases/$(database)/documents/units/$(data.unitId)).data) || data.ownerUid == get(/databases/$(database)/documents/units/$(data.unitId)).data.ownerUid);
    }

    function safeTechnicianTicketUpdate() {
      return signedIn() && techOwns(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
          'technicianNotes',
          'techNotes',
          'workNotes',
          'notes',
          'startedAt',
          'completedAt',
          'arrivedAt',
          'beforePhotos',
          'afterPhotos',
          'afterPhotoUrl',
          'proofPhotos',
          'completionPhotos',
          'evidencePhotos',
          'evidenceStatus',
          'resolutionSummary',
          'materialsUsed',
          'partsDisposition',
          'proofReadiness',
          'tenantApprovalStatus',
          'arrivedLocation',
          'technicianLocation',
          'technicianLocationUpdatedAt',
          'gpsVerified',
          'gpsVerifiedAt',
          'onSiteVerification'
        ]) &&
        (!('assignedTechnicianId' in request.resource.data) || request.resource.data.assignedTechnicianId == resource.data.get('assignedTechnicianId', null)) &&
        (!('technicianId' in request.resource.data) || request.resource.data.technicianId == resource.data.get('technicianId', null)) &&
        (!('techId' in request.resource.data) || request.resource.data.techId == resource.data.get('techId', null)) &&
        (!('priority' in request.resource.data) || request.resource.data.priority == resource.data.get('priority', null)) &&
        (!('paymentVerified' in request.resource.data) || request.resource.data.paymentVerified == resource.data.get('paymentVerified', null)) &&
        (!('status' in request.resource.data) || request.resource.data.status in ['ASSIGNED', 'IN_PROGRESS', 'ARRIVED', 'COMPLETED', 'RESOLVED', 'assigned', 'in_progress', 'arrived', 'completed']);
    }

    function missionClaimFieldsLookValid() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedTechnicianId', 'technicianId', 'techId', 'status', 'updatedAt', 'assignedAt']) &&
        (!('assignedTechnicianId' in request.resource.data) || request.resource.data.assignedTechnicianId == request.auth.uid) &&
        (!('technicianId' in request.resource.data) || request.resource.data.technicianId == request.auth.uid) &&
        (!('techId' in request.resource.data) || request.resource.data.techId == request.auth.uid) &&
        (!('status' in request.resource.data) || request.resource.data.status in ['ASSIGNED', 'assigned', 'IN_PROGRESS', 'in_progress']);
    }

    function safeOpenMissionClaim() {
      return hasTechnicianDispatchAuthority() && openMissionAvailable(resource.data) && missionClaimFieldsLookValid();
    }

    function canAccessMaintenanceTicket(ticketId) {
      return signedIn() && exists(/databases/$(database)/documents/maintenanceTickets/$(ticketId)) && participantCanRead(get(/databases/$(database)/documents/maintenanceTickets/$(ticketId)).data);
    }

    function safeTicketMessageCreate(ticketId) {
      return canAccessMaintenanceTicket(ticketId) &&
        (!('senderId' in request.resource.data) || request.resource.data.senderId == request.auth.uid) &&
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) &&
        (!('createdBy' in request.resource.data) || request.resource.data.createdBy == request.auth.uid);
    }

    function ownerBankOwner(data) {
      return signedIn() && (
        data.get('ownerId', null) == request.auth.uid ||
        data.get('ownerUid', null) == request.auth.uid ||
        emailMatches(data.get('ownerEmail', null))
      );
    }

    function safeOwnerBankAccountCreate(data) {
      return ownerBankOwner(data) &&
        data.keys().hasOnly([
          'ownerId',
          'ownerUid',
          'ownerEmail',
          'iban',
          'maskedIban',
          'last4',
          'bankName',
          'accountHolder',
          'accountHolderName',
          'verificationStatus',
          'status',
          'verified',
          'approved',
          'createdAt',
          'updatedAt'
        ]) &&
        (!('verified' in data) || data.verified == false) &&
        (!('approved' in data) || data.approved == false) &&
        (!('verifiedAt' in data)) &&
        (!('verifiedBy' in data)) &&
        (!('approvedAt' in data)) &&
        (!('approvedBy' in data)) &&
        (!('status' in data) || data.status in ['PENDING_VERIFICATION', 'PENDING', 'SUBMITTED']) &&
        (!('verificationStatus' in data) || data.verificationStatus in ['PENDING', 'PENDING_VERIFICATION']);
    }

    function safeOwnerBankAccountUpdate() {
      return ownerBankOwner(resource.data) &&
        ownerBankOwner(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'iban',
          'maskedIban',
          'last4',
          'bankName',
          'accountHolder',
          'accountHolderName',
          'verificationStatus',
          'status',
          'updatedAt'
        ]) &&
        (!('verified' in request.resource.data) || request.resource.data.verified == resource.data.get('verified', null)) &&
        (!('approved' in request.resource.data) || request.resource.data.approved == resource.data.get('approved', null)) &&
        (!('verifiedAt' in request.resource.data) || request.resource.data.verifiedAt == resource.data.get('verifiedAt', null)) &&
        (!('verifiedBy' in request.resource.data) || request.resource.data.verifiedBy == resource.data.get('verifiedBy', null)) &&
        (!('approvedAt' in request.resource.data) || request.resource.data.approvedAt == resource.data.get('approvedAt', null)) &&
        (!('approvedBy' in request.resource.data) || request.resource.data.approvedBy == resource.data.get('approvedBy', null)) &&
        (!('status' in request.resource.data) || request.resource.data.status in ['PENDING_VERIFICATION', 'PENDING', 'SUBMITTED']) &&
        (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus in ['PENDING', 'PENDING_VERIFICATION']);
    }

    function safeUserBootstrapCreate(data, userId) {
      return signedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'phoneNumber',
          'status',
          'createdAt',
          'updatedAt',
          'lastLoginAt',
          'platform',
          'isStandalone',
          'userAgent',
          'fcmTokens',
          'notificationPreferences',
          'language',
          'preferences'
        ]) &&
        (!('uid' in data) || data.uid == request.auth.uid) &&
        (!('email' in data) || data.email == request.auth.token.email) &&
        (!('status' in data) || data.status == 'role_required');
    }

    function safeUserSelfUpdate(userId) {
      return signedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'phone',
          'phoneNumber',
          'mobile',
          'preferredLanguage',
          'language',
          'lang',
          'legalAcceptedAt',
          'legalAcceptedAtClient',
          'pdplCompliance',
          'gpsConsent',
          'legalAcceptedVersion',
          'termsAcceptedAt',
          'termsVersion',
          'privacyAcceptedAt',
          'notificationPreferences',
          'fcmTokens',
          'platform',
          'isStandalone',
          'userAgent',
          'lastLoginAt',
          'lastSeenAt',
          'pushEnabled',
          'pushPermission',
          'deviceInfo',
          'onboardingLastSeenAt',
          'dutyStatus',
          'onDuty',
          'companyName',
          'reraLicense',
          'reraStatus',
          'reraVerified',
          'primaryRegion',
          'brokerTerritory',
          'tradeLicenseNumber',
          'emiratesIdNumber',
          'passportNumber',
          'bankName',
          'bankAccountHolder',
          'bankIban',
          'iban',
          'commissionAgreementAccepted',
          'commissionAgreementAcceptedAt',
          'commissionTermsVersion',
          'brokerKycStatus',
          'brokerProfileCompletion',
          'profileCompletionScore',
          'updatedAt'
        ]) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.get('role', null)) &&
        (!('userRole' in request.resource.data) || request.resource.data.userRole == resource.data.get('userRole', null)) &&
        (!('primaryRole' in request.resource.data) || request.resource.data.primaryRole == resource.data.get('primaryRole', null)) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.get('isAdmin', null)) &&
        (!('admin' in request.resource.data) || request.resource.data.admin == resource.data.get('admin', null)) &&
        (!('superAdmin' in request.resource.data) || request.resource.data.superAdmin == resource.data.get('superAdmin', null)) &&
        (!('super_admin' in request.resource.data) || request.resource.data.super_admin == resource.data.get('super_admin', null)) &&
        (!('permissions' in request.resource.data) || request.resource.data.permissions == resource.data.get('permissions', null)) &&
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.get('status', null)) &&
        (!('reraVerified' in request.resource.data) || request.resource.data.reraVerified == false || request.resource.data.reraVerified == resource.data.get('reraVerified', null)) &&
        (!('reraStatus' in request.resource.data) || request.resource.data.reraStatus in ['PENDING', 'NOT_SUBMITTED'] || request.resource.data.reraStatus == resource.data.get('reraStatus', null)) &&
        (!('brokerKycStatus' in request.resource.data) || request.resource.data.brokerKycStatus in ['INCOMPLETE', 'PENDING_REVIEW'] || request.resource.data.brokerKycStatus == resource.data.get('brokerKycStatus', null)) &&
        (!('onboardingComplete' in request.resource.data) || request.resource.data.onboardingComplete == resource.data.get('onboardingComplete', null)) &&
        (!('propertyId' in request.resource.data) || request.resource.data.propertyId == resource.data.get('propertyId', null)) &&
        (!('unitId' in request.resource.data) || request.resource.data.unitId == resource.data.get('unitId', null));
    }

    function safeOwnerProfileCreate(data, ownerId) {
      return signedIn() && request.auth.uid == ownerId &&
        (!('role' in data) || data.role == 'owner') &&
        (!('status' in data) || !(data.status in ['ACTIVE','active'])) &&
        (!('dashboardUnlocked' in data)) &&
        (!('paymentVerified' in data));
    }

    function safeOwnerProfileUpdate() {
      return signedIn() &&
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.get('status', null)) &&
        (!('dashboardUnlocked' in request.resource.data) || request.resource.data.dashboardUnlocked == resource.data.get('dashboardUnlocked', null)) &&
        (!('paymentVerified' in request.resource.data) || request.resource.data.paymentVerified == resource.data.get('paymentVerified', null));
    }

    function ownsOnboardingProof(data) {
      return signedIn() && (
        data.get('ownerUid', null) == request.auth.uid ||
        data.get('ownerId', null) == request.auth.uid ||
        data.get('userId', null) == request.auth.uid ||
        data.get('createdByUid', null) == request.auth.uid ||
        emailMatches(data.get('email', null)) ||
        emailMatches(data.get('ownerEmail', null))
      );
    }

    function safeOnboardingProofCreate(data) {
      return ownsOnboardingProof(data) &&
        (!('verified' in data) || data.verified == false) &&
        (!('approved' in data) || data.approved == false) &&
        (!('adminApproved' in data) || data.adminApproved == false) &&
        (!('paymentVerified' in data) || data.paymentVerified == false);
    }

    // ── AUDIT LOGS — server-only writes ──────────────────────────────────────
    // Client code MUST NOT write directly to audit_logs or auditLogs.
    // All writes must go through the logUserAuditAction Cloud Function which
    // uses the Admin SDK and therefore bypasses these rules entirely.
    match /audit_logs/{logId} {
      allow read: if isAdmin() || isAuditor();
      allow create: if false;  // server-only via Cloud Function
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /auditLogs/{logId} {
      allow read: if isAdmin() || isAuditor();
      allow create: if false;  // server-only via Cloud Function
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow get: if isAdmin() || isHr() || isFinance() || isOps() || emailOwns(resource.data) ||
                  (signedIn() && request.auth.uid != userId && resource.data.get('role', '') == 'tenant' &&
                   ((resource.data.get('ownerId', '') != '' && resource.data.get('ownerId', '') == request.auth.uid) ||
                    (resource.data.get('ownerEmail', '') != '' && resource.data.get('ownerEmail', '') == request.auth.token.get('email', ''))));
      allow list: if isAdmin() || isHr() || isFinance() || isOps();
      allow create: if isAdmin() || safeUserBootstrapCreate(request.resource.data, userId);
      allow update: if isAdmin() || safeUserSelfUpdate(userId);
      allow delete: if isAdmin();
      match /{document=**} {
        allow read: if isAdmin() || isHr() || (signedIn() && request.auth.uid == userId);
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
