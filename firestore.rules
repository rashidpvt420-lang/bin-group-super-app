      allow create: if canManageProperties() || ownerDraftCreate(request.resource.data);
      allow update: if canManageProperties() || (owns(resource.data) && request.resource.data.get('ownerId', null) == resource.data.get('ownerId', null) && (!('status' in request.resource.data) || !(request.resource.data.status in ['active', 'ACTIVE'])));
      allow delete: if isAdmin();
