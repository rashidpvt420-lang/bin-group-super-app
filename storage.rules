rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null &&
        request.auth.token.get('suspended', false) != true;
    }

    function hasAnyRole(roles) {
      return isAuth() && (
        request.auth.token.get('role', '') in roles ||
        request.auth.token.get('userRole', '') in roles ||
        request.auth.token.get('primaryRole', '') in roles
      );
    }

    function claimedRole() {
      return isAuth()
        ? request.auth.token.get(
            'role',
            request.auth.token.get('userRole', request.auth.token.get('primaryRole', null))
          )
        : null;
    }

    function isAdmin() {
      return isAuth() && (
        (
          claimedRole() == null &&
          (
            request.auth.token.get('admin', false) == true ||
            request.auth.token.get('isAdmin', false) == true
          )
        ) ||
        request.auth.token.get('ceo', false) == true ||
        hasAnyRole(['admin', 'super_admin', 'ceo', 'ADMIN', 'SUPER_ADMIN', 'CEO'])
      );
    }

    function isHrRole() {
      return isAdmin() || hasAnyRole(['hr_admin', 'hr_manager', 'hr_staff', 'finance_admin', 'finance_staff', 'account_manager']);
    }

    function isAuditor() {
      return hasAnyRole(['AUDITOR', 'auditor', 'compliance_officer']);
    }

    function isOwnerRole() {
      return hasAnyRole(['owner', 'OWNER']);
    }

    function hasVerifiedEmail() {
      return isAuth() &&
        request.auth.token.get('email_verified', false) == true &&
        request.auth.token.get('email', null) != null;
    }

    function ticketExists(ticketId) {
      return firestore.exists(/databases/(default)/documents/maintenanceTickets/$(ticketId));
    }

    function ticket(ticketId) {
      return firestore.get(/databases/(default)/documents/maintenanceTickets/$(ticketId)).data;
    }

    function canReadTicketEvidence(ticketId) {
      return isAuth() && ticketExists(ticketId) && (
        isAdmin() ||
        isAuditor() ||
        ticket(ticketId).get('ownerId', null) == request.auth.uid ||
        ticket(ticketId).get('ownerUid', null) == request.auth.uid ||
        ticket(ticketId).get('tenantId', null) == request.auth.uid ||
        ticket(ticketId).get('tenantUid', null) == request.auth.uid ||
        ticket(ticketId).get('assignedTechnicianId', null) == request.auth.uid ||
        ticket(ticketId).get('technicianId', null) == request.auth.uid ||
        ticket(ticketId).get('assignedTechId', null) == request.auth.uid ||
        ticket(ticketId).get('technicianUid', null) == request.auth.uid
      );
    }

    function canWriteTicketEvidence(ticketId) {
      return isAuth() && ticketExists(ticketId) && (
        isAdmin() ||
        ticket(ticketId).get('assignedTechnicianId', null) == request.auth.uid ||
        ticket(ticketId).get('technicianId', null) == request.auth.uid ||
        ticket(ticketId).get('assignedTechId', null) == request.auth.uid ||
        ticket(ticketId).get('technicianUid', null) == request.auth.uid
      );
    }

    function contractExists(contractId) {
      return firestore.exists(/databases/(default)/documents/contracts/$(contractId));
    }

    function contract(contractId) {
      return firestore.get(/databases/(default)/documents/contracts/$(contractId)).data;
    }

    function canReadContractFile(contractId) {
      return isAuth() && contractExists(contractId) && (
        isAdmin() ||
        isAuditor() ||
        contract(contractId).get('ownerId', null) == request.auth.uid ||
        contract(contractId).get('ownerUid', null) == request.auth.uid ||
        contract(contractId).get('createdBy', null) == request.auth.uid ||
        contract(contractId).get('userId', null) == request.auth.uid ||
        (hasVerifiedEmail() && (
          contract(contractId).get('recipientEmail', null) == request.auth.token.email ||
          contract(contractId).get('ownerEmail', null) == request.auth.token.email ||
          contract(contractId).get('email', null) == request.auth.token.email
        ))
      );
    }

    function invoiceExists(invoiceId) {
      return firestore.exists(/databases/(default)/documents/invoices/$(invoiceId));
    }

    function invoice(invoiceId) {
      return firestore.get(/databases/(default)/documents/invoices/$(invoiceId)).data;
    }

    function canReadInvoiceFile(invoiceId) {
      return isAuth() && invoiceExists(invoiceId) && (
        isAdmin() ||
        isAuditor() ||
        invoice(invoiceId).get('ownerId', null) == request.auth.uid ||
        invoice(invoiceId).get('ownerUid', null) == request.auth.uid ||
        invoice(invoiceId).get('payerId', null) == request.auth.uid ||
        invoice(invoiceId).get('userId', null) == request.auth.uid ||
        (hasVerifiedEmail() && (
          invoice(invoiceId).get('recipientEmail', null) == request.auth.token.email ||
          invoice(invoiceId).get('ownerEmail', null) == request.auth.token.email ||
          invoice(invoiceId).get('email', null) == request.auth.token.email
        ))
      );
    }

    function isAllowedImageContentType() {
      return request.resource != null && (
        request.resource.contentType.matches('image/.*')
      );
    }

    function isImageUpload(maxSizeMb) {
      return request.resource != null &&
             request.resource.size < maxSizeMb * 1024 * 1024 &&
             isAllowedImageContentType();
    }

    function isDocumentUpload(maxSizeMb) {
      return request.resource != null &&
             request.resource.size < maxSizeMb * 1024 * 1024 &&
             request.resource.contentType.matches('application/pdf|image/.*');
    }

    function hasTenantReceiptMetadata(tenantId) {
      return request.resource != null &&
        request.resource.metadata.tenantId == tenantId &&
        request.resource.metadata.evidenceType == 'tenant_payment_receipt' &&
        request.resource.metadata.receiptHash.matches('^[A-Fa-f0-9]{64}$');
    }

    match /maintenanceTickets/{tenantId}/{fileName} {
      allow read: if isAuth() && (request.auth.uid == tenantId || isAdmin() || isAuditor());
      allow write: if false;
    }

    match /inspections/{tenantId}/{fileName} {
      allow read: if isAuth() && (
        request.auth.uid == tenantId || 
        isAdmin() || 
        isAuditor() || 
        (firestore.exists(/databases/(default)/documents/users/$(tenantId)) && (
          firestore.get(/databases/(default)/documents/users/$(tenantId)).data.ownerId == request.auth.uid ||
          firestore.get(/databases/(default)/documents/users/$(tenantId)).data.ownerUid == request.auth.uid
        )) ||
        (firestore.exists(/databases/(default)/documents/tenants/$(tenantId)) && (
          firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid ||
          firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid
        ))
      );
      allow write: if isAuth() && request.auth.uid == tenantId && isImageUpload(10);
    }

    match /maintenanceTickets/{ticketId}/tenant/{fileName} {
      allow read: if canReadTicketEvidence(ticketId);
      allow write: if isAuth() && ticketExists(ticketId) && (
        ticket(ticketId).get('tenantId', null) == request.auth.uid ||
        ticket(ticketId).get('tenantUid', null) == request.auth.uid ||
        isAdmin()
      ) && isImageUpload(10);
    }

    match /maintenanceTickets/{ticketId}/owner/{fileName} {
      allow read: if canReadTicketEvidence(ticketId);
      allow write: if isAuth() && ticketExists(ticketId) && (
        ticket(ticketId).get('ownerId', null) == request.auth.uid ||
        ticket(ticketId).get('ownerUid', null) == request.auth.uid ||
        isAdmin()
      ) && isImageUpload(10);
    }

    match /maintenanceTickets/{ticketId}/proofs/{fileName} {
      allow read: if canReadTicketEvidence(ticketId);
      allow write: if canWriteTicketEvidence(ticketId) && isImageUpload(10);
    }

    match /maintenanceTickets/{ticketId}/proofPhotos/{fileName} {
      allow read: if canReadTicketEvidence(ticketId);
      allow write: if canWriteTicketEvidence(ticketId) && isImageUpload(10);
    }

    match /maintenanceTickets/{ticketId}/completionPhotos/{fileName} {
      allow read: if canReadTicketEvidence(ticketId);
      allow write: if canWriteTicketEvidence(ticketId) && isImageUpload(10);
    }

    match /design_requests/{userId}/{allPaths=**} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin() || isAuditor());
      allow create, update: if isAuth() && request.auth.uid == userId && isImageUpload(50);
      allow delete: if isAuth() && (request.auth.uid == userId || isAdmin());
    }

    match /ai_design_renders/{userId}/{allPaths=**} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin() || isAuditor());
      allow create, update, delete: if isAdmin();
    }

    match /proofs/{ticketId}/{allPaths=**} {
      allow read: if canReadTicketEvidence(ticketId);
      allow write: if canWriteTicketEvidence(ticketId) && isImageUpload(10);
    }

    match /payment-references/owners/{ownerId}/{paymentId}/{allPaths=**} {
      allow read: if isAuth() && (request.auth.uid == ownerId || isAdmin() || isAuditor());
      allow write: if request.resource != null &&
        resource == null &&
        isAuth() &&
        (request.auth.uid == ownerId || isAdmin()) &&
        isDocumentUpload(15) &&
        request.resource.metadata.ownerUid == ownerId &&
        request.resource.metadata.paymentId == paymentId &&
        request.resource.metadata.evidenceType == 'owner_payment_receipt' &&
        request.resource.metadata.receiptHash.matches('^[a-f0-9]{64}$');
    }

    match /owners/{ownerId}/{allPaths=**} {
      allow read: if isAuth() && (request.auth.uid == ownerId || isAdmin() || isAuditor());
      allow write: if isAuth() && (request.auth.uid == ownerId || isAdmin()) && isDocumentUpload(15);
    }

    match /tenants/{tenantId}/{allPaths=**} {
      allow read: if isAuth() && (request.auth.uid == tenantId || isAdmin() || isAuditor());
      allow write: if isAuth() && (request.auth.uid == tenantId || isAdmin()) && isDocumentUpload(15);
    }

    match /brokerDocuments/{brokerId}/{allPaths=**} {
      allow read: if isAuth() && (request.auth.uid == brokerId || isAdmin() || isAuditor());
      allow write: if request.resource != null &&
        resource == null &&
        isAuth() &&
        (request.auth.uid == brokerId || isAdmin()) &&
        isDocumentUpload(15) &&
        request.resource.metadata.brokerId == brokerId &&
        request.resource.metadata.documentType in [
          'emirates_id',
          'passport',
          'trade_license',
          'rera_license',
          'bank_details',
          'broker_agreement'
        ];
      allow delete: if isAuth() && (request.auth.uid == brokerId || isAdmin());
    }

    match /staffDocuments/{staffId}/{allPaths=**} {
      allow read: if isAuth() && (request.auth.uid == staffId || isHrRole() || isAuditor());
      allow write: if isAuth() && (request.auth.uid == staffId || isHrRole()) && isDocumentUpload(15);
      allow delete: if isHrRole();
    }

    match /hrDocuments/{staffId}/{allPaths=**} {
      allow read: if isAuth() && (request.auth.uid == staffId || isHrRole() || isAuditor());
      allow write: if isHrRole() && isDocumentUpload(25);
      allow delete: if isHrRole();
    }

    match /contracts/{contractId}/{allPaths=**} {
      allow read: if canReadContractFile(contractId);
      allow write: if isAdmin() && isDocumentUpload(25);
    }

    match /invoices/{invoiceId}/{allPaths=**} {
      allow read: if canReadInvoiceFile(invoiceId);
      allow write: if isAdmin() && isDocumentUpload(15);
    }

    match /kyc_documents/{documentId} {
      allow write: if isAuth() && (documentId.matches(request.auth.uid + '.*') || isAdmin()) && isDocumentUpload(15);
      allow read: if isAuth() && (documentId.matches(request.auth.uid + '.*') || isAdmin() || isAuditor());
    }

    match /onboarding-proof/{userId}/{intakeId}/{allPaths=**} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin() || isAuditor());
      allow write: if isAuth() && request.auth.uid == userId && isDocumentUpload(15);
    }

    match /evidence/{ticketId}/{fileName} {
      allow read: if canReadTicketEvidence(ticketId);
      allow write: if canWriteTicketEvidence(ticketId) && isImageUpload(10);
    }

    match /receipts/{tenantId}/{fileName} {
      allow read: if isAuth() && (request.auth.uid == tenantId || isAdmin() || isAuditor());
      allow write: if isAuth() &&
        request.auth.uid == tenantId &&
        isDocumentUpload(10) &&
        hasTenantReceiptMetadata(tenantId);
    }

    match /temp_kyc/{userId}/{fileName} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuth() && request.auth.uid == userId && isDocumentUpload(15);
    }

    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
