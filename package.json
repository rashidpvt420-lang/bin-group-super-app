{
  "name": "bin-group-super-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "functions"
  ],
  "engines": {
    "node": "22"
  },
  "scripts": {
    "prepare": "node scripts/prepare-hooks.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:live": "node scripts/prepare-production-env.mjs && vite build && npm --prefix apps/admin-panel install --legacy-peer-deps && npm --prefix apps/admin-panel run build",
    "setup:e2e": "npm install --legacy-peer-deps",
    "launch:deploy:hosting": "node scripts/refuse-ungated-production-deploy.mjs",
    "build:lowmem": "VITE_SKIP_MINIFY=1 NODE_OPTIONS=--max-old-space-size=2048 vite build",
    "build:shared": "npm run build --workspace=@bin/shared",
    "build:admin": "npm --prefix apps/admin-panel install --legacy-peer-deps && npm --prefix apps/admin-panel run build",
    "build:owner": "npm --prefix apps/owner-app install --legacy-peer-deps && npm --prefix apps/owner-app run build",
    "build:functions": "npm run build --workspace=functions",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "repair-admin": "node scripts/repair-admin-claims.mjs",
    "deploy": "node scripts/refuse-ungated-production-deploy.mjs",
    "deploy:raw": "node scripts/refuse-ungated-production-deploy.mjs",
    "normalize:rules": "node scripts/normalize-firestore-rules.mjs",
    "normalize:rule-tests": "node scripts/normalize-security-rules-test.mjs",
    "harden:rules": "node scripts/harden-firestore-rules.mjs",
    "harden:rules:warnings": "node scripts/harden-firestore-warning-rules.mjs",
    "harden:owner-trust-rules": "node scripts/harden-owner-trust-rules.mjs",
    "harden:bin-connect-rules": "node scripts/harden-bin-connect-rules.mjs",
    "harden:system-secrets": "node scripts/harden-system-secrets-rules.mjs",
    "harden:ticket-binding": "node scripts/apply-ticket-rule-binding.mjs",
    "prepare:rules": "npm run normalize:rules && npm run harden:rules && npm run harden:rules:warnings && npm run harden:owner-trust-rules && npm run harden:bin-connect-rules && npm run harden:system-secrets && node scripts/apply-profile-admin-rule.mjs && npm run harden:ticket-binding",
    "verify:rules-hardening": "node scripts/verify-firestore-launch-hardening.mjs",
    "verify:audit-bridge": "node scripts/verify-audit-write-bridge.mjs",
    "verify:uae-domination": "node scripts/verify-uae-domination-foundation.mjs",
    "test": "npm run test:rules",
    "test:rules": "npm run normalize:rule-tests && npm run prepare:rules && npm run verify:rules-hardening && firebase emulators:exec --only firestore --project bin-group-57c60 \"node --test test/security-rules.test.js\"",
    "test:rules:node": "npm run normalize:rule-tests && npm run prepare:rules && npm run verify:rules-hardening && firebase emulators:exec --only firestore \"node --test test/security-rules.test.js\"",
    "test:lockfile-platforms": "node --test test/package-lock-platform-natives.test.mjs",
    "test:stability": "npm run test:lockfile-platforms && npm run prepare:rules && npm run verify:rules-hardening && npm run verify:audit-bridge && node scripts/production-stability-guard.mjs",
    "test:runtime-audit": "node scripts/production-runtime-audit.mjs",
    "test:mobile-store-readiness": "node scripts/mobile-store-readiness-audit.mjs",
    "test:repo-hygiene": "npm run normalize:rules && node scripts/repo-hygiene-guard.mjs",
    "test:launch-clearance": "node scripts/verify-launch-clearance.mjs",
    "test:pilot-clearance": "node scripts/verify-launch-clearance.mjs --pilot",
    "test:route-consolidation": "node scripts/verify-route-consolidation.mjs",
    "test:hard-launch-readiness": "npm run test:route-consolidation && node scripts/verify-hard-launch-readiness.mjs && node scripts/verify-profile-evidence-coverage.mjs",
    "test:gate12:smtp": "node scripts/verify-smtp-live-delivery.mjs",
    "test:gate12:appcheck": "node scripts/verify-appcheck-debug-registration.mjs",
    "launch:blockers": "node scripts/print-hard-launch-blockers.mjs",
    "launch:pass": "node scripts/record-launch-proof.mjs",
    "launch:hard-gate": "npm run test:launch-clearance && npm run test:hard-launch-readiness && npm run launch:hard-status",
    "launch:status": "node scripts/launch-status.mjs",
    "launch:hard-status": "node scripts/verify-hard-launch-approval.mjs",
    "launch:pilot-incident": "node scripts/write-pilot-incident-report.mjs",
    "launch:hard-approve": "node scripts/write-hard-launch-approval.mjs",
    "launch:fix-all": "node scripts/launch-fix-all.mjs",
    "launch:pilot-watch": "node scripts/pilot-launch-watch.mjs",
    "launch:evidence": "node scripts/record-launch-evidence-batch.mjs",
    "launch:evidence:run": "node scripts/run-critical-evidence.mjs",
    "hard-launch:authorize": "node scripts/create-hard-launch-authorization.mjs",
    "hard-launch:predeploy": "node scripts/hard-launch-predeploy-gate.mjs",
    "hard-launch:approval-gate": "node scripts/hard-launch-approval-gate.mjs",
    "hard-launch:decision": "node scripts/hard-launch-decision-gate.mjs",
    "hard-launch:status": "node scripts/hard-launch-status.mjs",
    "hard-launch:incidents": "node scripts/create-production-incidents-attestation.mjs",
    "verify:production-deployment": "node scripts/verify-production-deployment.mjs",
    "measure:functions-load": "node scripts/measure-functions-load.mjs",
    "e2e:ensure-appcheck": "node scripts/ensure-e2e-appcheck-debug.mjs",
    "verify:admin-firebase": "node scripts/verify-admin-firebase-build.mjs",
    "test:launch-honesty": "node --test test/launch-honesty.test.mjs test/production-workflow-security.test.mjs test/hard-launch-gate.test.mjs test/hard-launch-control.test.mjs tests/launch/*.test.mjs",
    "test:hr-smoke": "node scripts/hr-smoke-test.mjs",
    "test:uae-platform-config": "node scripts/verify-uae-platform-config.mjs",
    "test:uae-market-leadership-master": "node scripts/verify-uae-market-leadership-master.mjs",
    "test:e2e": "playwright install --with-deps chromium && playwright test",
    "test:e2e:env": "node scripts/verify-e2e-env.mjs",
    "test:e2e:public": "playwright install --with-deps chromium && E2E_BASE_URL=${E2E_BASE_URL:-https://bin-group-57c60.web.app} playwright test --grep \"production public smoke\" --project=chromium-desktop",
    "test:e2e:local": "npm run build && playwright install --with-deps chromium && playwright test --grep \"production public smoke\" --project=chromium-desktop",
    "test:e2e:launch-audit": "npm run test:e2e:env && npm run e2e:ensure-appcheck && playwright install --with-deps chromium && playwright test tests/e2e/launch-audit-*.spec.ts tests/e2e/hard-launch-routes.spec.ts --project=chromium-desktop",
    "test:e2e:launch-audit:live": "node scripts/run-live-launch-audit.mjs",
    "test:e2e:business": "node scripts/run-critical-evidence.mjs --suite all-business",
    "test:e2e:walkthrough": "npm run test:e2e:env && npm run e2e:ensure-appcheck && playwright install --with-deps chromium && playwright test tests/e2e/launch-five-profile-walkthrough.spec.ts --project=chromium-desktop",
    "test:e2e:profile-gates": "npm run test:e2e:env && npm run e2e:ensure-appcheck && node scripts/verify-hosted-appcheck.mjs && playwright install --with-deps chromium && playwright test tests/e2e/profile-readiness-gates.spec.ts --project=chromium-desktop",
    "test:e2e:gate11:routes": "node scripts/gate11-staging-route-check.mjs",
    "test:e2e:gate11:staging": "npm run test:e2e:env && npm run e2e:ensure-appcheck && npm run test:e2e:gate11:routes && playwright install --with-deps chromium && playwright test tests/e2e/gate11-staging-smoke.spec.ts --project=chromium-desktop",
    "seed:e2e": "node scripts/seed-e2e-accounts.js",
    "seed:e2e:auth": "node scripts/seed-e2e-auth.mjs",
    "seed:e2e:live-data": "node scripts/seed-live-role-test-data.mjs",
    "seed:e2e:gate11": "node scripts/seed-gate11-fixtures.mjs",
    "seed:gate11:fixtures": "node scripts/seed-gate11-fixtures.mjs",
    "payroll:generate-payslips": "node scripts/payroll-generate-payslips.mjs",
    "mobile:init": "npm run build && npx cap sync",
    "mobile:add:android": "npx cap add android",
    "mobile:add:ios": "npx cap add ios",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:open:android": "npx cap open android",
    "mobile:open:ios": "npx cap open ios",
    "mobile:check": "npm run test:mobile-store-readiness && npm run build"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.0",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/core": "^7.4.4",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/geolocation": "^7.1.5",
    "@capacitor/push-notifications": "^7.0.3",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@firebase/auth": "^1.7.9",
    "@fontsource/cairo": "^5.2.7",
    "@google/generative-ai": "^0.24.1",
    "@mui/icons-material": "^5.14.0",
    "@mui/material": "^5.15.0",
    "axios": "^1.4.0",
    "firebase": "^12.14.0",
    "framer-motion": "^10.12.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.0.1",
    "notistack": "^3.0.2",
    "papaparse": "^5.5.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.19",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^6.14.1",
    "recharts": "^2.7.2",
    "stylis": "^4.2.0",
    "stylis-plugin-rtl": "^2.1.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.54.0",
    "@types/node": "^20.11.17",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "5.1.1",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "esbuild": "^0.27.1",
    "eslint": "^8.56.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "0.4.20",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "^15.19.1",
    "globals": "^13.24.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "vite": "7.2.6"
  }
}
