# Copy to .env.e2e (gitignored) for local/CI E2E.
# Do NOT commit real passwords or the App Check debug token.

E2E_BASE_URL=https://bin-group-57c60.web.app
E2E_ADMIN_BASE_URL=https://bin-group-admin-panel.web.app

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_TENANT_EMAIL=
E2E_TENANT_PASSWORD=
E2E_TECHNICIAN_EMAIL=
E2E_TECHNICIAN_PASSWORD=
E2E_BROKER_EMAIL=
E2E_BROKER_PASSWORD=

# Registered Firebase App Check debug UUID (NOT YOUR_REGISTERED_UUID).
# Register the SAME token under App Check → Apps → Debug tokens for:
#   1) main Firebase Web App (bin-group-57c60.web.app)
#   2) admin Firebase Web App (bin-group-admin-panel.web.app)
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Optional diagnostics (masked in logs)
# VITE_FIREBASE_APP_ID=1:123413252227:web:285cb53bc26626d699f3b6
# ADMIN_FIREBASE_APP_ID=1:123413252227:web:285cb53bc26626d699f3b6

# Launch clearance must NOT set these:
# E2E_ALLOW_MISSING_ENV=true
# E2E_SKIP_APPCHECK_TOKEN=true
