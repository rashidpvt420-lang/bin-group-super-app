# Copy to .env.e2e (gitignored) for local/CI E2E.
# Do NOT commit real passwords, service accounts, or the App Check debug token.
#
# Prerequisite before business / walkthrough / launch-audit / profile-gates live suites:
#   npm run seed:e2e:gate11
# (creates Auth users + linked Firestore fixtures for all five roles)

E2E_BASE_URL=https://bin-group-57c60.web.app
E2E_ADMIN_BASE_URL=https://bin-group-admin-panel.web.app
GCP_PROJECT_ID=bin-group-57c60

# Five canonical launch roles (required for launch clearance)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_TENANT_EMAIL=
E2E_TENANT_PASSWORD=
E2E_TECHNICIAN_EMAIL=
E2E_TECHNICIAN_PASSWORD=
E2E_BROKER_EMAIL=
E2E_BROKER_PASSWORD=

# Optional: second technician for concurrent mission-claim walkthrough only.
# When set, seed:e2e:gate11 creates the Tech B Auth user and an OPEN pool ticket.
E2E_TECHNICIAN_B_EMAIL=
E2E_TECHNICIAN_B_PASSWORD=

# Registered Firebase App Check debug UUID (NOT YOUR_REGISTERED_UUID).
# Register the SAME token under App Check → Apps → Debug tokens for:
#   1) main Firebase Web App (bin-group-57c60.web.app)
#   2) admin Firebase Web App (bin-group-admin-panel.web.app)
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Required for tests/e2e/business-admin.spec.ts Firestore seed/cleanup (JSON or base64 JSON).
# Use a dedicated E2E service account with least privilege. Never commit the real value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: universal password for scripts/seed-e2e-accounts.js legacy seeder only.
# Canonical launch path uses per-role E2E_*_PASSWORD above via seed:e2e:gate11.
# E2E_UNIVERSAL_PASSWORD=

# Optional diagnostics (masked in logs)
# VITE_FIREBASE_APP_ID=1:123413252227:web:285cb53bc26626d699f3b6
# ADMIN_FIREBASE_APP_ID=1:123413252227:web:285cb53bc26626d699f3b6

# Launch clearance must NOT set these:
# E2E_ALLOW_MISSING_ENV=true
# E2E_SKIP_APPCHECK_TOKEN=true
